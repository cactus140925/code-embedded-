void drawHand(int centerX, int centerY, float angleDeg, int length) {
  float rad = angleDeg * 3.14159 / 180;
  int x = centerX + length * sin(rad);
  int y = centerY - length * cos(rad);
  display.drawLine(centerX, centerY, x, y, SSD1306_WHITE);
}

// Hàm cập nhật thời tiết từ Wifi
void fetchWeatherData() {
    WiFiClient client;
    HTTPClient http;
    http.begin(client, weatherURL); 
    int httpCode = http.GET();
    if (httpCode > 0) {
      String payload = http.getString();
      JsonDocument doc; 
      DeserializationError error = deserializeJson(doc, payload);
      if (!error) {
        currentTemp = doc["current"]["temperature_2m"];
        currentWeatherCode = doc["current"]["weather_code"];
      }
    }
    http.end();
}

// Hàm cập nhật dữ liệu tổng quát
void updateDataFromWifi() {
  if (WiFi.status() == WL_CONNECTED) {
    if (timeClient.forceUpdate()) {
       if (timeClient.getEpochTime() > 1600000000) {
          manualTimeOffset = 0; 
       }
    }
    fetchWeatherData();
    lastUpdateEpoch = millis(); 
  }
}

void saveAlarm() {
  EEPROM.write(0, alarmMonth);
  EEPROM.write(1, alarmDay);
  EEPROM.write(2, alarmHour);
  EEPROM.write(3, alarmMinute);
  EEPROM.write(4, alarmEnabled ? 1 : 0);
  EEPROM.commit(); 
}

void loadAlarm() {
  int m = EEPROM.read(0);
  int d = EEPROM.read(1);
  int h = EEPROM.read(2);
  int min = EEPROM.read(3);
  int en = EEPROM.read(4);

  if (m >= 1 && m <= 12 && d >= 1 && d <= 31 && h >= 0 && h <= 23 && min >= 0 && min <= 59) {
    alarmMonth = m;
    alarmDay = d;
    alarmHour = h;
    alarmMinute = min;
    alarmEnabled = (en == 1);
  }
}

void applyManualTime() {
  struct tm t;
  t.tm_year = manualSetYear - 1900;
  t.tm_mon  = manualSetMonth - 1;
  t.tm_mday = manualSetDay;
  t.tm_hour = manualSetHour;
  t.tm_min  = manualSetMinute;
  t.tm_sec  = 0;
  t.tm_isdst = 0; 

  time_t targetEpoch = mktime(&t); 
  manualTimeOffset = targetEpoch - timeClient.getEpochTime();
}

// --- HÀM PHÁT ÂM THANH BÁO THỨC ---
unsigned long lastBeepTime = 0;
const int melody[] = { 
  784, 1047, 1319, 1047, 784, 0, 
  784, 1047, 1319, 1047, 784, 0,
  0 
};
const int noteDurations[] = { 
  120, 120, 120, 120, 240, 50, 
  120, 120, 120, 120, 240, 50, 
  1000 
};
const int totalNotes = 13;
int currentNote = 0;

void playAlarmMelody() {
  unsigned long currentMillis = millis();
  if (currentMillis - lastBeepTime >= noteDurations[currentNote]) {
    lastBeepTime = currentMillis;
    currentNote++;
    if (currentNote >= totalNotes) currentNote = 0;
    
    int noteFreq = melody[currentNote];
    if (noteFreq > 0) tone(BUZZ, noteFreq);
    else noTone(BUZZ);
  }
}

